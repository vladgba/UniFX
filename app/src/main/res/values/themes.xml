<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#263238</item>
        <item name="android:colorPrimaryDark">#1C262B</item>
        <item name="android:colorAccent">#F0A500</item>
    </style>

    <!-- Screens that draw their own header (text editor). Inherits AppTheme's day/night colors. -->
    <style name="AppTheme.NoBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Selection bar: drawn over the top lines, primary color, light icons/text. -->
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">?android:attr/colorPrimary</item>
        <item name="android:actionBarTheme">@android:style/ThemeOverlay.Material.Dark.ActionBar</item>
    </style>

    <!-- Invisible entry activity: shows only a spinner while copying a file from another app. -->
    <style name="AppTheme.Translucent">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
