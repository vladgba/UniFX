<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#263238</item>
        <item name="android:colorPrimaryDark">#1C262B</item>
        <item name="android:colorAccent">#F0A500</item>
